<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="drone_lab">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.65 0.72 0.78 1</background>
      <shadows>false</shadows>
    </scene>
    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>14 -14 9 0 0.45 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Visible and collidable boundary of the flight area: 20 x 16 m. -->
    <model name="boundary_north"><static>true</static><pose>0 8 0.75 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>20 0.12 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.12 1.5</size></box></geometry><material><diffuse>0.85 0.55 0.08 1</diffuse></material></visual></link></model>
    <model name="boundary_south"><static>true</static><pose>0 -8 0.75 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>20 0.12 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.12 1.5</size></box></geometry><material><diffuse>0.85 0.55 0.08 1</diffuse></material></visual></link></model>
    <model name="boundary_east"><static>true</static><pose>10 0 0.75 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.12 16 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 16 1.5</size></box></geometry><material><diffuse>0.85 0.55 0.08 1</diffuse></material></visual></link></model>
    <model name="boundary_west"><static>true</static><pose>-10 0 0.75 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.12 16 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 16 1.5</size></box></geometry><material><diffuse>0.85 0.55 0.08 1</diffuse></material></visual></link></model>

    <model name="landing_pad">
      <static>true</static>
      <pose>0 0 0.03 0 0 0</pose>
      <link name="pad">
        <collision name="collision"><geometry><cylinder><radius>2.2</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>2.2</radius><length>0.08</length></cylinder></geometry><material><ambient>0.08 0.35 0.16 1</ambient><diffuse>0.10 0.55 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="warehouse">
      <static>true</static>
      <pose>8 3 2 0 0 0</pose>
      <link name="building">
        <collision name="collision"><geometry><box><size>5 4 4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5 4 4</size></box></geometry><material><ambient>0.30 0.32 0.36 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse></material></visual>
      </link>
    </model>

    <model name="tree_1"><static>true</static><pose>-5 -4 1.5 0 0 0</pose><link name="trunk"><visual name="trunk"><geometry><cylinder><radius>0.22</radius><length>3</length></cylinder></geometry><material><diffuse>0.28 0.12 0.04 1</diffuse></material></visual><visual name="crown"><pose>0 0 2.3 0 0 0</pose><geometry><sphere><radius>1.25</radius></sphere></geometry><material><diffuse>0.05 0.38 0.10 1</diffuse></material></visual></link></model>
    <model name="tree_2"><static>true</static><pose>-8 5 1.7 0 0 0</pose><link name="trunk"><visual name="trunk"><geometry><cylinder><radius>0.25</radius><length>3.4</length></cylinder></geometry><material><diffuse>0.28 0.12 0.04 1</diffuse></material></visual><visual name="crown"><pose>0 0 2.6 0 0 0</pose><geometry><sphere><radius>1.4</radius></sphere></geometry><material><diffuse>0.05 0.38 0.10 1</diffuse></material></visual></link></model>
    <model name="tree_3"><static>true</static><pose>5 -7 1.4 0 0 0</pose><link name="trunk"><visual name="trunk"><geometry><cylinder><radius>0.2</radius><length>2.8</length></cylinder></geometry><material><diffuse>0.28 0.12 0.04 1</diffuse></material></visual><visual name="crown"><pose>0 0 2.2 0 0 0</pose><geometry><sphere><radius>1.15</radius></sphere></geometry><material><diffuse>0.05 0.38 0.10 1</diffuse></material></visual></link></model>

    <model name="drone">
      <pose>0 0 3.0 0 0 0</pose>
      <link name="base">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.03</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>1.1 0.7 0.22</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>1.1 0.7 0.22</size></box></geometry><material><ambient>0.05 0.08 0.12 1</ambient><diffuse>0.08 0.16 0.28 1</diffuse></material></visual>
        <visual name="nose"><pose>0.58 0 0 0 0 0</pose><geometry><box><size>0.18 0.38 0.18</size></box></geometry><material><diffuse>0.95 0.65 0.05 1</diffuse></material></visual>
        <visual name="arm_fl"><pose>0.45 0.45 0.05 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.1</length></cylinder></geometry><material><diffuse>0.15 0.18 0.22 1</diffuse></material></visual>
        <visual name="arm_fr"><pose>0.45 -0.45 0.05 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.1</length></cylinder></geometry><material><diffuse>0.15 0.18 0.22 1</diffuse></material></visual>
        <visual name="arm_rl"><pose>-0.45 0.45 0.05 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.1</length></cylinder></geometry><material><diffuse>0.15 0.18 0.22 1</diffuse></material></visual>
        <visual name="arm_rr"><pose>-0.45 -0.45 0.05 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.1</length></cylinder></geometry><material><diffuse>0.15 0.18 0.22 1</diffuse></material></visual>
        <visual name="rotor_fl"><pose>0.45 0.45 0.16 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="rotor_fr"><pose>0.45 -0.45 0.16 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="rotor_rl"><pose>-0.45 0.45 0.16 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="rotor_rr"><pose>-0.45 -0.45 0.16 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
      <plugin name="force_control" filename="libgazebo_ros_force.so"><ros><namespace>/drone</namespace></ros><link_name>base</link_name><force_frame>world</force_frame></plugin>
      <plugin name="ground_truth" filename="libgazebo_ros_p3d.so"><ros><namespace>/drone</namespace><remapping>odom:=odom</remapping></ros><body_name>base</body_name><frame_name>world</frame_name><update_rate>30</update_rate><gaussian_noise>0</gaussian_noise></plugin>
    </model>
  </world>
</sdf>
